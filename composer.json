{
    "name": "nitsan/ns-googledocs",
    "type": "typo3-cms-extension",
    "description": "Google Docs - Manually transferring all content from Google Docs to your TYPO3 website can be a boring task, right? We understand your concerns, which is why we've created an efficient solution to simplify this migration process for TYPO3 users. Our innovative solution allows you to import your Google Docs directly into your TYPO3 pages with just one click, saving you valuable time.",
    "homepage": "https://t3planet.com/ns-google-docs-typo3-extension",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "TYPO3 CMS",
        "Site",
        "Google",
        "TYPO3 Google Docs ",
        "Cloud",
        "Docs"
    ],
    "support": {
        "issues": "https://github.com/nitsan-technologies/ns_googledocs/issues"
    },
    "require": {
        "ext-dom": "*",
        "ext-intl": "*",
        "ext-libxml": "*",
        "ext-simplexml": "*",
        "php": "^8.1",
        "google/apiclient": "^2.15",
        "nitsan/ns-license": "^14.5.4",
        "typo3/cms-backend": "^12.4 || ^13.4 || ^14.0",
        "typo3/cms-core": "^12.4 || ^13.4 || ^14.0",
        "typo3/cms-extbase": "^12.4 || ^13.4 || ^14.0",
        "typo3/cms-fluid": "^12.4 || ^13.4 || ^14.0",
        "typo3/cms-frontend": "^12.4 || ^13.4 || ^14.0"
    },
    "autoload": {
        "psr-4": {
            "NITSAN\\NsGoogledocs\\": "Classes/"
        }
    },
    "replace": {
        "typo3-ter/ns-googledocs": "self.version"
    },
    "scripts": {
        "pre-autoload-dump": "Google\\Task\\Composer::cleanup"
    },
    "config": {
        "vendor-dir": "vendor",
        "bin-dir": "bin",
        "sort-packages": true,
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "ns_googledocs"
        },
        "google/apiclient-services": [
            "Drive"
        ]
    }
}
